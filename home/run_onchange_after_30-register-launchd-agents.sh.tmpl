{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Register repo-managed launchd LaunchAgents (kryota-dev/dotfiles#257, #365, #368, #371).
# Re-runs whenever any managed plist changes (embedded hashes below, one per
# agent so each is tracked independently). Wrapper script changes need no
# re-registration: launchd execs the file fresh on every fire.
# dev.kryota.morning-radar plist hash: {{ include "Library/LaunchAgents/dev.kryota.morning-radar.plist.tmpl" | sha256sum }}
# dev.kryota.knowledge-distill plist hash: {{ include "Library/LaunchAgents/dev.kryota.knowledge-distill.plist.tmpl" | sha256sum }}
# dev.kryota.macos-defaults-drift plist hash: {{ include "Library/LaunchAgents/dev.kryota.macos-defaults-drift.plist.tmpl" | sha256sum }}
# dev.kryota.ntfy-dashboard plist hash: {{ include "Library/LaunchAgents/dev.kryota.ntfy-dashboard.plist.tmpl" | sha256sum }}
set -euo pipefail

# CI runners have no gui launchd domain, so bootstrap can never succeed there.
# Skip inside CI only — unlike deleting this script in the workflow, the
# render/apply path stays CI-validated. Outside CI a bootstrap failure must
# hard-fail so chezmoi retries on the next apply (lifecycle convention #6).
if [ -n "${CI:-}" ]; then
  echo "[launchd-agents] CI detected; skipping launchctl registration."
  exit 0
fi

domain="gui/$(id -u)"
labels=(dev.kryota.morning-radar dev.kryota.knowledge-distill dev.kryota.macos-defaults-drift dev.kryota.ntfy-dashboard)

status=0
for label in "${labels[@]}"; do
  plist="$HOME/Library/LaunchAgents/${label}.plist"
  echo "[launchd-agents] registering ${label}..."
  launchctl bootout "${domain}/${label}" 2>/dev/null || true
  if ! launchctl bootstrap "${domain}" "${plist}"; then
    echo "[launchd-agents] bootstrap failed for ${label} (no GUI session?). Re-run 'chezmoi apply' from a GUI terminal." >&2
    status=1
    continue
  fi
  echo "[launchd-agents] ${label} registered."
done

exit "$status"
{{ end -}}
