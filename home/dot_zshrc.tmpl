# ========== zsh options ==========
setopt auto_pushd
setopt pushd_ignore_dups
setopt hist_ignore_dups
setopt share_history
setopt inc_append_history
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000
export SAVEHIST=100000

# ========== PATH ==========
export PATH="$HOME/.local/bin:$PATH"

# Per-account agent launchers (~/.local/launchers): the claude/codex wrappers plus the
# cld/cld-r06/cdx/cdx-r06 symlinks. Kept on PATH so the wrappers resolve from any shell; the
# precmd hook below re-asserts this dir ahead of mise's per-tool dirs, which mise re-prepends on
# every prompt via hook-env (#345).
case ":$PATH:" in
  *":$HOME/.local/launchers:"*) ;;
  *) export PATH="$HOME/.local/launchers:$PATH" ;;
esac

# pnpm
{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="{{ .chezmoi.homeDir }}/Library/pnpm"
{{ else -}}
export PNPM_HOME="{{ .chezmoi.homeDir }}/.local/share/pnpm"
{{ end -}}
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# ========== tools (sync load) ==========
if command -v mise &>/dev/null; then eval "$(mise activate zsh)"; fi
if command -v direnv &>/dev/null; then eval "$(direnv hook zsh)"; fi
if command -v starship &>/dev/null; then eval "$(starship init zsh)"; fi
if command -v zoxide &>/dev/null; then eval "$(zoxide init zsh)"; fi

# Keep the per-account launcher dir ahead of mise's per-tool install dirs, which `mise activate`
# re-prepends on every prompt via its own precmd hook-env. Registered here, after `mise activate`,
# so this precmd runs after mise's and wins — letting bare `claude` resolve to the wrapper, not the
# mise-managed binary, in interactive shells (#345).
_launcher_path_precmd() { path=("$HOME/.local/launchers" "${(@)path:#$HOME/.local/launchers}"); }
autoload -Uz add-zsh-hook && add-zsh-hook precmd _launcher_path_precmd

# ========== sheldon (deferred plugins) ==========
if command -v sheldon &>/dev/null; then eval "$(sheldon source)"; fi
