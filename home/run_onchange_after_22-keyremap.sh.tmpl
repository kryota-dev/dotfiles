#!/bin/bash
# LaunchAgent のハッシュ: {{ include "Library/LaunchAgents/dev.kryota.dotfiles.keyremap.plist" | sha256sum }}
set -euo pipefail

# 再ログインを待たずに反映する
plist="${HOME}/Library/LaunchAgents/dev.kryota.dotfiles.keyremap.plist"
domain="gui/$(id -u)"
launchctl bootout "${domain}" "${plist}" 2>/dev/null || true
launchctl bootstrap "${domain}" "${plist}"
