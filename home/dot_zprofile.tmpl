# Set Homebrew
{{ if eq .chezmoi.os "darwin" -}}
{{ if eq .chezmoi.arch "arm64" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/usr/local/bin/brew shellenv)"
{{ end -}}
{{ else if eq .chezmoi.os "linux" -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}

# Environment variables
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LANG=ja_JP.UTF-8

{{ if eq .chezmoi.os "darwin" -}}
# phone-harness keeps the agent's own helpers in agent_helpers.py and defaults
# that directory to <repo>/agent-workspace — a path a wheel install does not
# have. Point it somewhere stable and outside chezmoi's source tree, so the
# helpers an agent writes mid-session survive every `chezmoi apply`. Exported
# here rather than from a ~/.config/zsh module because those load deferred via
# sheldon (interactive shells only), and agents run phone-harness from
# non-interactive ones. run_onchange_after_19-setup-phone-harness.sh.tmpl
# creates this directory; tests/phone_harness.bats keeps the two paths in sync.
export PH_AGENT_WORKSPACE="$HOME/.local/share/phone-harness/agent-workspace"

# Android SDK (cask android-commandlinetools). sdkmanager installs emulator/ and
# system-images/ under this root, so every Android tool needs ANDROID_HOME to find
# them. Exported here rather than from a ~/.config/zsh module for the same reason as
# PH_AGENT_WORKSPACE above: those load deferred via sheldon (interactive shells only),
# and agents drive the emulator from non-interactive ones.
#
# platform-tools is deliberately NOT on this PATH: adb already comes from the
# `android-platform-tools` cask at $(brew --prefix)/bin. Two adb binaries on one host
# desync the adb server ("adb server version doesn't match this client"), so we keep
# exactly one and let ANDROID_HOME cover only the pieces brew does not ship.
export ANDROID_HOME="{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/share/android-commandlinetools"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/emulator:$PATH"

{{ end -}}
# PATH deduplication
typeset -gU path

# Per-account agent launchers (~/.local/launchers): also prepend here, in a login-sourced file, so
# a non-interactive login shell (`zsh -lc '<cmd>'`) — which does not source ~/.zshrc — still
# resolves the claude/codex wrappers (and the brew auto-dump shim, #360) rather than the bare
# mise/brew binary (#345). Interactive
# shells additionally get a precmd hook in ~/.zshrc to stay ahead of mise's per-prompt re-prepend.
case ":$PATH:" in
  *":$HOME/.local/launchers:"*) ;;
  *) export PATH="$HOME/.local/launchers:$PATH" ;;
esac

# Less settings
export LESS='-R -M -i -W -z-4'
export LESSCHARSET=utf-8
