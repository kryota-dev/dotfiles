#!/bin/sh
# A fixed host-action entry point. Keep this POSIX-only: it clears the invoking
# environment before Bash starts, so BASH_ENV and Git variables cannot change the
# authority of an approved action.
set -eu

account_user=$(/usr/bin/id -un) || exit 1
if [ "$(/usr/bin/uname -s)" = "Darwin" ]; then
  account_home="/Users/$account_user"
elif [ -x /usr/bin/getent ]; then
  account_home=$(/usr/bin/getent passwd "$account_user" | /usr/bin/awk -F: 'NR == 1 { print $6 }')
else
  printf '%s\n' 'agent-workflow: could not determine the account home directory' >&2
  exit 1
fi

if [ ! -d "$account_home" ]; then
  printf '%s\n' 'agent-workflow: could not determine the account home directory' >&2
  exit 1
fi

IMPLEMENTATION="$account_home/.local/bin/agent-workflow-host"
if [ ! -f "$IMPLEMENTATION" ] || [ ! -r "$IMPLEMENTATION" ]; then
  printf '%s\n' 'agent-workflow: host implementation is unavailable' >&2
  exit 1
fi

exec /usr/bin/env -i \
  HOME="$account_home" USER="$account_user" LOGNAME="$account_user" \
  AGENT_WORKFLOW_ACCOUNT_HOME="$account_home" \
  PATH='/usr/bin:/bin:/usr/sbin:/sbin' \
  /bin/bash "$IMPLEMENTATION" "$@"
