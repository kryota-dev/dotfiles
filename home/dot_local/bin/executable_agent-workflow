#!/usr/bin/env bash
# A deliberately narrow host-side executor for approved agent workflows.
set -euo pipefail

STATE_ROOT="${AGENT_WORKFLOW_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-workflow}"
readonly STATE_ROOT

die() {
  printf 'agent-workflow: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  agent-workflow worktree-init <run-id> --branch <name> [--base <ref>]
  agent-workflow init <run-id> [--worktree <path>] [--phase <name>]
  agent-workflow status <run-id>
  agent-workflow commit <run-id> --message-file <file> -- <file>...
  agent-workflow push <run-id>
  agent-workflow prepare-pr <run-id> --title-file <file> --body-file <file>
  agent-workflow create-pr <run-id> --title-file <file> --body-file <file> --base <branch> [--draft]
  agent-workflow checks <run-id> [--watch]
  agent-workflow ready-for-review <run-id> <pr-number>
  agent-workflow prune
EOF
}

valid_component() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$ ]]
}

valid_branch() {
  local branch="$1"
  [[ "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$ ]] || return 1
  git check-ref-format --branch "$branch" >/dev/null 2>&1
}

state_file() {
  valid_component "$1" || die "invalid run id"
  printf '%s/%s/state.tsv\n' "$STATE_ROOT" "$1"
}

state_value() {
  local file="$1" key="$2"
  awk -F '\t' -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$file"
}

set_state_value() {
  local file="$1" key="$2" value="$3" temp
  [[ "$value" != *$'\t'* && "$value" != *$'\n'* ]] || die "invalid state value"
  temp="${file}.tmp"
  awk -F '\t' -v key="$key" -v value="$value" '
    $1 == "version" { print "version\t2"; version_seen = 1; next }
    $1 == "approved_gates" { next }
    $1 == key { print key "\t" value; seen = 1; next }
    { print }
    END {
      if (!version_seen) print "version\t2"
      if (!seen) print key "\t" value
    }
  ' "$file" >"$temp"
  mv "$temp" "$file"
}

require_state() {
  local file
  file="$(state_file "$1")"
  [[ -f "$file" ]] || die "unknown run id: $1"
  printf '%s\n' "$file"
}

require_linked_worktree() {
  local worktree="$1" git_dir common_dir
  [[ -d "$worktree" ]] || die "worktree does not exist"
  git_dir="$(git -C "$worktree" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || die "not a git worktree"
  common_dir="$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || die "not a git worktree"
  [[ "$git_dir" != "$common_dir" ]] || die "refusing to operate on the main worktree"
}

require_main_worktree() {
  local root git_dir common_dir
  root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not in a git worktree"
  git_dir="$(git -C "$root" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || die "not a git worktree"
  common_dir="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || die "not a git worktree"
  [[ "$git_dir" == "$common_dir" ]] || die "worktree-init must run from the main worktree"
  printf '%s\n' "$root"
}

repository_slug() {
  local worktree="$1" remote slug
  remote="$(git -C "$worktree" config --get remote.origin.url)" || die "origin remote is not configured"
  case "$remote" in
    git@github.com:*) slug="${remote#git@github.com:}" ;;
    https://github.com/*) slug="${remote#https://github.com/}" ;;
    ssh://git@github.com/*) slug="${remote#ssh://git@github.com/}" ;;
    *) die "origin must be a GitHub remote" ;;
  esac
  slug="${slug%.git}"
  [[ "$slug" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || die "could not determine GitHub repository"
  printf '%s\n' "$slug"
}

path_in_worktree() {
  local worktree="$1" path="$2" candidate resolved
  worktree="$(cd "$worktree" && pwd -P)" || die "worktree does not exist"
  if [[ "$path" = /* ]]; then
    candidate="$path"
  else
    candidate="$worktree/$path"
  fi
  [[ ! -L "$candidate" ]] || die "symbolic links are not allowed for host action paths"
  resolved="$(cd "$(dirname "$candidate")" && pwd -P)/$(basename "$candidate")"
  case "$resolved" in
    "$worktree"/*) printf '%s\n' "$resolved" ;;
    *) die "path is outside the recorded worktree" ;;
  esac
}

path_in_run_state() {
  local state="$1" path="$2" directory candidate resolved
  directory="$(cd "$(dirname "$state")" && pwd -P)"
  if [[ "$path" = /* ]]; then
    candidate="$path"
  else
    candidate="$directory/$path"
  fi
  [[ ! -L "$candidate" ]] || die "symbolic links are not allowed for host action paths"
  resolved="$(cd "$(dirname "$candidate")" && pwd -P)/$(basename "$candidate")"
  case "$resolved" in
    "$directory"/*) printf '%s\n' "$resolved" ;;
    *) die "path is outside the recorded run state" ;;
  esac
}

initialize_state() {
  local run_id="$1" worktree="$2" phase="$3"
  valid_component "$run_id" || die "invalid run id"
  require_linked_worktree "$worktree"
  valid_component "$phase" || die "invalid phase"
  local directory file branch
  directory="$STATE_ROOT/$run_id"
  file="$directory/state.tsv"
  [[ ! -e "$directory" ]] || die "run already exists: $run_id"
  branch="$(git -C "$worktree" branch --show-current)"
  [[ -n "$branch" ]] || die "detached HEAD is not supported"
  umask 077
  mkdir -p "$directory"
  printf 'version\t2\nrun_id\t%s\nworktree\t%s\nbranch\t%s\nphase\t%s\ncreated_at\t%s\npr_number\t\n' \
    "$run_id" "$worktree" "$branch" "$phase" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >"$file"
}

init_run() {
  local run_id="$1"
  shift
  local worktree phase
  worktree="$(pwd -P)"
  phase="created"
  while (($#)); do
    case "$1" in
      --worktree)
        (($# >= 2)) || die "--worktree requires a path"
        worktree="$2"
        shift 2
        ;;
      --phase)
        (($# >= 2)) || die "--phase requires a name"
        phase="$2"
        shift 2
        ;;
      *) die "unknown init option: $1" ;;
    esac
  done
  initialize_state "$run_id" "$worktree" "$phase"
  printf '%s\n' "$run_id"
}

worktree_init_run() {
  local run_id="$1"
  shift
  local branch="" base="main" main_worktree worktree
  while (($#)); do
    case "$1" in
      --branch)
        (($# >= 2)) || die "--branch requires a name"
        branch="$2"
        shift 2
        ;;
      --base)
        (($# >= 2)) || die "--base requires a ref"
        base="$2"
        shift 2
        ;;
      *) die "unknown worktree-init option: $1" ;;
    esac
  done
  valid_component "$run_id" || die "invalid run id"
  valid_branch "$branch" || die "invalid branch name"
  main_worktree="$(require_main_worktree)"
  git -C "$main_worktree" rev-parse --verify --quiet "${base}^{commit}" >/dev/null || die "base ref does not resolve to a commit"
  [[ ! -e "$STATE_ROOT/$run_id" ]] || die "run already exists: $run_id"
  command -v wtp >/dev/null 2>&1 || die "wtp is required to create a worktree"
  worktree="$(cd "$main_worktree" && wtp add -b "$branch" "$base" --quiet)"
  require_linked_worktree "$worktree"
  initialize_state "$run_id" "$worktree" "worktree-created"
  printf '%s\n' "$worktree"
}

commit_run() {
  local run_id="$1"
  shift
  local state message_file=""
  state="$(require_state "$run_id")"
  (($# >= 3)) || die "commit requires --message-file and file paths"
  [[ "$1" == "--message-file" ]] || die "commit requires --message-file"
  message_file="$2"
  shift 2
  [[ "$1" == "--" ]] || die "commit requires -- before file paths"
  shift
  (($#)) || die "commit requires at least one file"
  local worktree branch path
  worktree="$(state_value "$state" worktree)"
  branch="$(state_value "$state" branch)"
  require_linked_worktree "$worktree"
  [[ "$(git -C "$worktree" branch --show-current)" == "$branch" ]] || die "recorded branch is not checked out"
  message_file="$(path_in_worktree "$worktree" "$message_file")"
  [[ -f "$message_file" ]] || die "commit message file does not exist"
  for path in "$@"; do
    path="$(path_in_worktree "$worktree" "$path")"
    git -C "$worktree" add -- "$path"
  done
  git -C "$worktree" commit -F "$message_file"
  set_state_value "$state" phase committed
}

push_run() {
  local run_id="$1" state worktree branch
  state="$(require_state "$run_id")"
  worktree="$(state_value "$state" worktree)"
  branch="$(state_value "$state" branch)"
  require_linked_worktree "$worktree"
  [[ "$(git -C "$worktree" branch --show-current)" == "$branch" ]] || die "recorded branch is not checked out"
  git -C "$worktree" push -u origin "$branch"
  set_state_value "$state" phase pushed
}

prepare_pr_run() {
  local run_id="$1"
  shift
  local state title_file="" body_file=""
  state="$(require_state "$run_id")"
  while (($#)); do
    case "$1" in
      --title-file)
        (($# >= 2)) || die "--title-file requires a path"
        title_file="$2"
        shift 2
        ;;
      --body-file)
        (($# >= 2)) || die "--body-file requires a path"
        body_file="$2"
        shift 2
        ;;
      *) die "unknown prepare-pr option: $1" ;;
    esac
  done
  [[ -n "$title_file" && -n "$body_file" ]] || die "prepare-pr requires title and body"
  local worktree branch directory title
  worktree="$(state_value "$state" worktree)"
  branch="$(state_value "$state" branch)"
  require_linked_worktree "$worktree"
  [[ "$(git -C "$worktree" branch --show-current)" == "$branch" ]] || die "recorded branch is not checked out"
  title_file="$(path_in_worktree "$worktree" "$title_file")"
  body_file="$(path_in_worktree "$worktree" "$body_file")"
  [[ -f "$title_file" && -f "$body_file" ]] || die "PR title or body source file does not exist"
  title="$(tr -d '\r\n' <"$title_file")"
  [[ -n "$title" ]] || die "PR title is empty"
  directory="$(dirname "$state")"
  umask 077
  install -m 600 "$title_file" "$directory/title.md"
  install -m 600 "$body_file" "$directory/body.md"
  set_state_value "$state" phase pr-drafted
}

create_pr_run() {
  local run_id="$1"
  shift
  local state title_file="" body_file="" base="" draft=""
  state="$(require_state "$run_id")"
  while (($#)); do
    case "$1" in
      --title-file)
        (($# >= 2)) || die "--title-file requires a path"
        title_file="$2"
        shift 2
        ;;
      --body-file)
        (($# >= 2)) || die "--body-file requires a path"
        body_file="$2"
        shift 2
        ;;
      --base)
        (($# >= 2)) || die "--base requires a branch"
        base="$2"
        shift 2
        ;;
      --draft)
        draft="--draft"
        shift
        ;;
      *) die "unknown create-pr option: $1" ;;
    esac
  done
  [[ -n "$title_file" && -n "$body_file" && -n "$base" ]] || die "create-pr requires title, body, and base"
  [[ "$base" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$ && "$base" != *..* && "$base" != *//* ]] || die "invalid base branch"
  local worktree branch title output pr_number repo
  worktree="$(state_value "$state" worktree)"
  branch="$(state_value "$state" branch)"
  require_linked_worktree "$worktree"
  [[ "$(git -C "$worktree" branch --show-current)" == "$branch" ]] || die "recorded branch is not checked out"
  title_file="$(path_in_run_state "$state" "$title_file")"
  body_file="$(path_in_run_state "$state" "$body_file")"
  [[ -f "$title_file" && -f "$body_file" ]] || die "PR title or body file does not exist"
  title="$(tr -d '\r\n' <"$title_file")"
  [[ -n "$title" ]] || die "PR title is empty"
  repo="$(repository_slug "$worktree")"
  local -a create_args=(gh pr create --repo "$repo")
  [[ -z "$draft" ]] || create_args+=(--draft)
  create_args+=(--title "$title" --body-file "$body_file" --base "$base" --head "$branch")
  output="$("${create_args[@]}")"
  pr_number="${output##*/}"
  [[ "$pr_number" =~ ^[0-9]+$ ]] || die "could not parse PR number"
  set_state_value "$state" pr_number "$pr_number"
  set_state_value "$state" phase pr-created
  printf '%s\n' "$output"
}

checks_run() {
  local run_id="$1"
  shift
  local state worktree pr_number repo
  state="$(require_state "$run_id")"
  case "$#" in
    0) ;;
    1) [[ "$1" == "--watch" ]] || die "unknown checks option: $1" ;;
    *) die "checks accepts only --watch" ;;
  esac
  worktree="$(state_value "$state" worktree)"
  pr_number="$(state_value "$state" pr_number)"
  require_linked_worktree "$worktree"
  [[ "$pr_number" =~ ^[0-9]+$ ]] || die "run has no PR number"
  repo="$(repository_slug "$worktree")"
  if (($# == 1)); then
    gh pr checks "$pr_number" --repo "$repo" --watch
  else
    gh pr checks "$pr_number" --repo "$repo"
  fi
}

ready_for_review_run() {
  local run_id="$1" pr_number="$2" state worktree recorded_pr_number repo
  state="$(require_state "$run_id")"
  [[ "$pr_number" =~ ^[0-9]+$ ]] || die "invalid PR number"
  recorded_pr_number="$(state_value "$state" pr_number)"
  [[ "$pr_number" == "$recorded_pr_number" ]] || die "PR number does not match the recorded run"
  worktree="$(state_value "$state" worktree)"
  require_linked_worktree "$worktree"
  repo="$(repository_slug "$worktree")"
  gh pr ready "$pr_number" --repo "$repo"
  set_state_value "$state" phase ready-for-review
}

prune_runs() {
  [[ -d "$STATE_ROOT" ]] || exit 0
  [[ "$STATE_ROOT" = */agent-workflow ]] || die "state root must end in /agent-workflow"
  [[ "$STATE_ROOT" != "/agent-workflow" ]] || die "refusing to prune a broad state root"
  find "$STATE_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime +30 -exec rm -rf {} +
}

main() {
  (($#)) || {
    usage
    exit 2
  }
  local command="$1"
  shift
  case "$command" in
    worktree-init)
      (($# >= 1)) || die "worktree-init requires a run id"
      worktree_init_run "$@"
      ;;
    init)
      (($# >= 1)) || die "init requires a run id"
      init_run "$@"
      ;;
    status)
      (($# == 1)) || die "status requires a run id"
      cat "$(require_state "$1")"
      ;;
    commit)
      (($# >= 1)) || die "commit requires a run id"
      commit_run "$@"
      ;;
    push)
      (($# == 1)) || die "push requires a run id"
      push_run "$1"
      ;;
    prepare-pr)
      (($# >= 1)) || die "prepare-pr requires a run id"
      prepare_pr_run "$@"
      ;;
    create-pr)
      (($# >= 1)) || die "create-pr requires a run id"
      create_pr_run "$@"
      ;;
    checks)
      (($# >= 1)) || die "checks requires a run id"
      checks_run "$@"
      ;;
    ready-for-review)
      (($# == 2)) || die "ready-for-review requires a run id and PR number"
      ready_for_review_run "$@"
      ;;
    prune)
      (($# == 0)) || die "prune takes no arguments"
      prune_runs
      ;;
    -h | --help | help) usage ;;
    *) die "unknown command: $command" ;;
  esac
}

main "$@"
