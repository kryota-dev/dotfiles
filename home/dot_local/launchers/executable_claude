#!/usr/bin/env bash
# Per-account launcher for Claude Code. Dispatches on $0 (the name it was invoked as):
#   claude, cld -> personal account, fill-gaps (keeps an inherited CLAUDE_CONFIG_DIR so a
#                  hook-spawned child stays on its parent session's account)
#   cld-r06     -> work (r06) account, unconditional override
# It injects the same per-account isolation env the retired `_claude_with_home` zsh helper did,
# then execs the mise-managed claude binary (resolved via `mise which`, which follows the pin).
# Being a real file on PATH, this works from any shell — interactive, hook, launchd, Claude's
# Bash tool — not only interactive zsh, so the hand-copied env blocks it replaces cannot drift
# (#345). claude stays mise-managed; the ~/.local/bin/claude native-install symlink is untouched.
set -eu

# Lowercase the invoked name before dispatching: on a case-insensitive filesystem (macOS APFS
# default) a symlink invoked as e.g. `CLD-R06` resolves to the same file but $0 carries the typed
# case, which would miss the override branch and silently fall through to the personal account.
name="$(printf '%s' "${0##*/}" | tr '[:upper:]' '[:lower:]')"
case "$name" in
  cld-r06)
    # -r06 name: select the work account unconditionally (override).
    CLAUDE_CONFIG_DIR="$HOME/.claude-r06"
    ;;
  *)
    # claude / cld: fill-gaps only, so an inherited account survives.
    CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    ;;
esac

# Derive the homunculus slug from the config-dir basename, in the same three branches as
# run_onchange_after_14 and the retired _claude_with_home: .claude -> default,
# .claude-* -> the suffix, anything else -> strip a leading dot. Do NOT name an account dir
# ".claude-default": its slug would collide with ~/.claude's and silently merge two accounts'
# observations.
account_dir_name="${CLAUDE_CONFIG_DIR%/}"
account_dir_name="${account_dir_name##*/}"
case "$account_dir_name" in
  .claude) homunculus_slug=default ;;
  .claude-*) homunculus_slug="${account_dir_name#.claude-}" ;;
  *) homunculus_slug="${account_dir_name#.}" ;;
esac

# MCP web-search keys: source the 0600 secrets file (KEY='value', no export) into this process
# only, so bare `claude` and `cld` get identical keys without leaking them into the parent
# shell. Skip if the caller already decided EXA_API_KEY (even to an empty value) — that lets
# morning-radar opt out of web search by exporting an empty key.
if [ -z "${EXA_API_KEY+x}" ] && [ -r "$HOME/.config/zsh/claude-secrets.zsh" ]; then
  . "$HOME/.config/zsh/claude-secrets.zsh"
fi

# Resolve the pin-correct mise-managed binary directly (not via PATH, which would re-resolve
# this wrapper). `mise which` follows the pinned version; latest/2 symlinks track highest-ever
# instead, so they are deliberately not used. CLAUDE_LAUNCHER_BIN overrides the resolver for
# tests and unusual installs. Fail loudly rather than run a wrong binary.
real="${CLAUDE_LAUNCHER_BIN:-$(mise which claude 2>/dev/null || true)}"
if [ ! -x "$real" ]; then
  echo "claude launcher: could not resolve the mise-managed claude binary via 'mise which claude'." >&2
  echo "  Run 'mise install claude' then retry." >&2
  exit 127
fi

export CLAUDE_CONFIG_DIR
export ECC_AGENT_DATA_HOME="$CLAUDE_CONFIG_DIR"
export CLV2_HOMUNCULUS_DIR="$HOME/.local/share/ecc-homunculus-${homunculus_slug}"
export ECC_MCP_HEALTH_STATE_PATH="$CLAUDE_CONFIG_DIR/mcp-health-cache.json"
export GATEGUARD_STATE_DIR="$CLAUDE_CONFIG_DIR/.gateguard"
# Observer knobs, each overridable. The 300s watchdog (vs the 120s upstream default) lets the
# Haiku analysis pass finish (#256); OBSERVER_ACTIVE_HOURS 0/0 disables the clock gate that
# skipped cycles because sessions run past midnight (#336); MAX_TURNS 100 is the upstream cap,
# not the auto-scaled floor of 20 that cut the Read -> dedup -> Write pass off mid-write (#336).
export ECC_OBSERVER_TIMEOUT_SECONDS="${ECC_OBSERVER_TIMEOUT_SECONDS:-300}"
export OBSERVER_ACTIVE_HOURS_START="${OBSERVER_ACTIVE_HOURS_START:-0}"
export OBSERVER_ACTIVE_HOURS_END="${OBSERVER_ACTIVE_HOURS_END:-0}"
export ECC_OBSERVER_MAX_TURNS="${ECC_OBSERVER_MAX_TURNS:-100}"
export EXA_API_KEY="${EXA_API_KEY:-}"
export FIRECRAWL_API_KEY="${FIRECRAWL_API_KEY:-}"

# Append-system-prompt normalisation (#677). The "ask with AskUserQuestion instead of trailing a
# plain-text question" rule is injected as a system prompt rather than left in CLAUDE.md, where it
# did not hold (#614 added it; #677 measured three violations in one session). It goes in the
# wrapper, not in claude.zsh, because this is the one file every entry point reaches — interactive
# zsh, hooks, launchd, frontier-harness child sessions, Claude's own Bash tool (#345).
#
# Four measured properties of claude 2.1.259 shape the code below:
#   1. --append-system-prompt-file is NOT repeatable. It is declared .argParser(String), so a later
#      occurrence silently replaces an earlier one (passing two missing paths A then B reports only
#      B). A wrapper that merely appended its own flag would be overridden without a word by a
#      caller passing its own — which _claude_fable does for cldf. Layering is impossible; we fold.
#   2. The flag has to go BEFORE the first positional. After a subcommand it aborts with "error:
#      unknown option"; before it, the root command parses it and the subcommand still runs
#      (`claude --append-system-prompt-file <missing> mcp list` succeeds, so the root action — the
#      only thing that reads the file — never runs). Hence the prepend, and hence no subcommand
#      allowlist to maintain forever.
#   3. --append-system-prompt and --append-system-prompt-file are mutually exclusive ("Cannot use
#      both ... Please use only one.", exit 1).
#   4. The flag is undocumented (.hideHelp(), absent from `claude --help`), but depending on it is
#      safe because its removal is LOUD: an unknown option aborts with exit 1 instead of being
#      ignored, and a missing prompt file aborts too. Neither degrades silently.
# There is no env var or user-settings equivalent to fall back on: settings' appendSystemPrompt is
# read only from the enterprise policyHelper payload, which lives in admin-owned managed settings.
# A missing rule file leaves argv untouched, so the session still starts before `chezmoi apply` —
# the same trade-off _claude_fable already makes for the orchestrator prompt.
ask_rule_file="$HOME/.claude/ask-user-question-prompt.md"
if [ -r "$ask_rule_file" ]; then
  # Walk argv the way commander does: a bare "--" ends option parsing, "--flag value" and
  # "--flag=value" spell the same option, and the last occurrence wins. Kept arguments rotate to
  # the back of "$@" instead of into an array — macOS still ships bash 3.2, where expanding an
  # empty array under `set -u` is an error.
  caller_file=""
  caller_text=""
  saw_file=0
  saw_text=0
  end_of_opts=0
  remaining=$#
  while [ "$remaining" -gt 0 ]; do
    arg="$1"
    shift
    remaining=$((remaining - 1))
    if [ "$end_of_opts" -eq 0 ]; then
      case "$arg" in
        --)
          end_of_opts=1
          ;;
        --append-system-prompt-file)
          saw_file=1
          if [ "$remaining" -gt 0 ]; then
            caller_file="$1"
            shift
            remaining=$((remaining - 1))
          fi
          continue
          ;;
        --append-system-prompt-file=*)
          saw_file=1
          caller_file="${arg#*=}"
          continue
          ;;
        --append-system-prompt)
          saw_text=1
          if [ "$remaining" -gt 0 ]; then
            caller_text="$1"
            shift
            remaining=$((remaining - 1))
          fi
          continue
          ;;
        --append-system-prompt=*)
          saw_text=1
          caller_text="${arg#*=}"
          continue
          ;;
      esac
    fi
    set -- "$@" "$arg"
  done

  if [ "$saw_file" -eq 1 ] && [ "$saw_text" -eq 1 ]; then
    # Property 3: the CLI refuses this combination. Hand both back instead of picking a winner the
    # caller never chose — the wrapper must not turn a loud error into a silent preference.
    set -- --append-system-prompt "$caller_text" --append-system-prompt-file "$caller_file" "$@"
  else
    base_text=""
    if [ "$saw_file" -eq 1 ]; then
      # Also the path a bare trailing --append-system-prompt-file (no value) lands on: reported
      # here rather than by commander, but with the same exit 1, never a dropped rule.
      if [ ! -r "$caller_file" ]; then
        echo "claude launcher: append system prompt file is not readable: $caller_file" >&2
        exit 1
      fi
      base_text="$(cat "$caller_file")"
    elif [ "$saw_text" -eq 1 ]; then
      base_text="$caller_text"
    fi

    if [ -n "$base_text" ]; then
      # Fold the caller's prompt and the rule into the single occurrence property 1 allows. The
      # rule goes LAST: #677 is about the rule being buried, and the tail of the system prompt is
      # the salient end. Content-addressed, so concurrent launches with the same inputs converge on
      # one file and an unchanged prompt costs no write at all.
      composite_body="$(printf '%s\n\n%s' "$base_text" "$(cat "$ask_rule_file")")"
      cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-launcher"
      mkdir -p "$cache_dir" 2>/dev/null || true
      chmod 700 "$cache_dir" 2>/dev/null || true
      if command -v shasum >/dev/null 2>&1; then
        composite_key="$(printf '%s\n' "$composite_body" | shasum -a 256 | cut -d' ' -f1)"
      else
        composite_key="$(printf '%s\n' "$composite_body" | cksum | tr -cd '0-9')"
      fi
      prompt_arg="$cache_dir/append-system-prompt-$composite_key.md"
      if [ ! -s "$prompt_arg" ]; then
        # mktemp failing (unwritable cache dir) aborts under `set -e`, which is the intended
        # outcome: stopping beats starting a session that silently lost the rule.
        composite_tmp="$(mktemp "$cache_dir/.append-system-prompt.XXXXXX")"
        printf '%s\n' "$composite_body" >"$composite_tmp"
        chmod 600 "$composite_tmp"
        mv -f "$composite_tmp" "$prompt_arg"
      fi
    else
      prompt_arg="$ask_rule_file"
    fi
    set -- --append-system-prompt-file "$prompt_arg" "$@"
  fi
fi

exec "$real" "$@"
