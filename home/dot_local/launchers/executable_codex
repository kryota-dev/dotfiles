#!/usr/bin/env bash
# Per-account launcher for the Codex CLI. Dispatches on $0 (the name it was invoked as):
#   codex, cdx -> the account follows CLAUDE_CONFIG_DIR when it is set (authoritative), else the
#                 personal ~/.codex; a set-but-mismatched inherited CODEX_HOME is overridden so
#                 a codex run inside a cld-r06 session stays on r06 and a personal session cannot
#                 be dragged onto r06 by a stray CODEX_HOME.
#   cdx-r06    -> work (r06) account, unconditional override.
# It injects `--profile shared` (the chezmoi-managed SSOT config) when argv carries no --profile,
# then execs the brew-managed codex. Being a real file on PATH it works from any shell, so the
# codex skill's inline account-selection prelude is no longer needed (#345).
set -eu

case "${0##*/}" in
  cdx-r06)
    # -r06 name: work account, unconditional override.
    CODEX_HOME="$HOME/.codex-r06"
    ;;
  *)
    # codex / cdx: CLAUDE_CONFIG_DIR is authoritative for the account when set.
    if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
      case "$CLAUDE_CONFIG_DIR" in
        *.claude-r06) CODEX_HOME="$HOME/.codex-r06" ;;
        *) CODEX_HOME="$HOME/.codex" ;;
      esac
    else
      CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
    fi
    ;;
esac
export CODEX_HOME

# Inject --profile shared only when argv carries no profile flag. Scan per token — recognising
# --profile, --profile=…, -p and -p<value> — and stop at a literal `--` so a "--profile"
# substring inside a prompt argument cannot false-match. codex accepts --profile as a global
# option, so insert it right after the program name, ahead of any subcommand (bare / exec /
# exec review), where every form parses.
has_profile=0
for arg in "$@"; do
  case "$arg" in
    --) break ;;
    --profile | --profile=* | -p | -p?*)
      has_profile=1
      break
      ;;
  esac
done
if [ "$has_profile" -eq 0 ]; then
  set -- --profile shared "$@"
fi

# CODEX_LAUNCHER_BIN overrides the brew location for tests and non-standard prefixes.
real="${CODEX_LAUNCHER_BIN:-/opt/homebrew/bin/codex}"
if [ ! -x "$real" ]; then
  echo "codex launcher: $real is not executable (is the codex cask installed?)." >&2
  exit 127
fi
exec "$real" "$@"
