{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_IDE_SKIP_VALID_CHECK": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "95",
    "MAX_THINKING_TOKENS": "127999"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(npx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(git show:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git remote -v)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(docker compose:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Bash(playwright:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(biome:*)",
      "Bash(osascript -e 'display notification*)",
      "Bash(gh search:*)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ],
    "ask": [
      "Bash(terraform destroy:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform workspace delete:*)",
      "Bash(terraform apply -auto-approve:*)",
      "Bash(terraform apply --auto-approve:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm delete:*)",
      "Bash(chezmoi destroy:*)",
      "Bash(chezmoi forget:*)",
      "Bash(chezmoi purge:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker image prune:*)",
      "Bash(docker container prune:*)",
      "Bash(docker network prune:*)",
      "Bash(brew uninstall:*)",
      "Bash(brew remove:*)",
      "Bash(brew rm:*)",
      "Bash(brew autoremove:*)",
      "Bash(brew untap:*)",
      "Bash(mas uninstall:*)",
      "Bash(mise uninstall:*)",
      "Bash(mise implode:*)",
      "Bash(mise prune:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh secret remove:*)",
      "Bash(gh cache delete:*)",
      "Bash(gh run delete:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase projects delete:*)",
      "Bash(npm publish:*)",
      "Bash(npm unpublish:*)",
      "Bash(yarn publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(defaults delete:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git reset:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Read(//**/.env)",
      "Read(//**/.envrc)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.production)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.keys)",
      "Read(//**/.env.vault)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*credentials*.json)",
      "Read(//**/*credentials*.yaml)",
      "Read(//**/*credentials*.yml)",
      "Read(//**/*secret*.json)",
      "Read(//**/*secret*.yaml)",
      "Read(//**/*secret*.yml)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gcloud/credentials.db)",
      "Read(~/.docker/config.json)",
      "Read(//**/secrets/**/*.json)",
      "Read(//**/secrets/**/*.yaml)",
      "Read(//**/secrets/**/*.yml)",
      "Read(//**/secrets/**/*.env)",
      "Edit(//**/.env*)",
      "Edit(//**/secrets/**/*.json)",
      "Edit(//**/secrets/**/*.yaml)",
      "Edit(//**/secrets/**/*.yml)",
      "Edit(//**/secrets/**/*.env)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(*.gmail-mcp*)",
      "Bash(*.gmail-mcp/credentials.json*)",
      "Bash(*.gmail-mcp/gcp-oauth.keys.json*)",
      "mcp__supabase__execute_sql",
      "mcp__codex-cu__js_add_node_module_dir",
      "mcp__codex-cu__turn_ended"
    ],
    "defaultMode": "auto"
  },
  "language": "Japanese",
  "autoMemoryEnabled": false,
  "alwaysThinkingEnabled": false,
  "cleanupPeriodDays": 20,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "hooks": {
    "Elicitation": [
      {
        "matcher": "codex-cu",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/codex-cu-gate.sh",
            "timeout": 45
          }
        ]
      }
    ]
  },
  "model": "claude-opus-5-5[1m]",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc",
        "ref": "v1.0.6"
      }
    }
  },
  "agentPushNotifEnabled": true,
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true
}
