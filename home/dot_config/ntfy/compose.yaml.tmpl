# Self-hosted ntfy notification server (kryota-dev/dotfiles#337).
#
# Rendered to ~/.config/ntfy/compose.yaml and reconciled by
# run_onchange_after_31-setup-ntfy.sh.tmpl via `docker compose up --detach`.
#
# Why Docker rather than a native binary: upstream ntfy states "Only the ntfy CLI is
# supported on macOS. ntfy server is currently not supported", and homebrew-core builds
# the macOS formula with `-tags noserver`, so `ntfy serve` does not exist in the Brewfile
# binary at all. The official Linux image under Docker Desktop is the supported route.
#
# Why no launchd unit: `restart: unless-stopped` plus Docker Desktop's own start-at-login
# already supervise this container. A LaunchAgent would be a second supervisor racing the
# first, and the repo's plist conventions (RunAtLoad deliberately absent) were written for
# a billed Claude run, not for a daemon.
services:
  ntfy:
    image: {{ .ntfy.image }}
    container_name: ntfy
    command: ["serve"]
    restart: unless-stopped
    ports:
      # Loopback ONLY. `tailscale serve` is the sole ingress: it proxies the tailnet to
      # this port over TLS. Binding to 0.0.0.0 would expose the server on every local
      # network, and binding to the tailnet address directly would put a 100.x literal in
      # a public repository and give up the free per-node certificate. Changing the
      # left-hand side away from 127.0.0.1 is a security regression; tests/files.bats
      # asserts the prefix.
      - "127.0.0.1:2586:80"
    volumes:
      # Long syntax with create_host_path: false, and this is a security control, not
      # style. With the short syntax Docker silently creates a missing bind source as an
      # empty DIRECTORY: ntfy would then find no config file, fall back to its built-in
      # defaults — where auth-default-access is "read-write" and no auth-file is set — and
      # `tailscale serve` would keep publishing it. That turns a missing file into an
      # anonymous read-write ntfy exposed to the whole tailnet. Failing to start is the
      # only acceptable behaviour here.
      - type: bind
        source: "{{ .chezmoi.homeDir }}/.config/ntfy/server.yml"
        target: /etc/ntfy/server.yml
        # The server never rewrites its own config.
        read_only: true
        bind:
          create_host_path: false
      # Message cache (cache.db) and auth database (user.db). Kept on the host so history
      # and credentials survive image upgrades and `docker compose down`. The setup script
      # creates this directory (0700) before the container starts.
      - type: bind
        source: "{{ .chezmoi.homeDir }}/.local/state/ntfy"
        target: /var/lib/ntfy
        bind:
          create_host_path: false
    # Baseline hardening. Deliberately NOT dropping all capabilities or setting `user:`:
    # the server listens on port 80 inside the container, so dropping CAP_NET_BIND_SERVICE
    # would stop it binding, and a uid override interacts with Docker Desktop's bind-mount
    # ownership mapping in ways that cannot be verified without running it. Revisit
    # together, not piecemeal.
    security_opt:
      - no-new-privileges:true
    mem_limit: 256m
    pids_limit: 128
    environment:
      # Affects log timestamps only — ntfy stores message times as Unix epochs. Matches
      # the JST assumption already baked into the morning-radar LaunchAgent.
      TZ: "Asia/Tokyo"
