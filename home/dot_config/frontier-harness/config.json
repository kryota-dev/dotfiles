{
  "version": 1,
  "rollout": "pilot",
  "retention": {
    "rawArtifactsDays": 30,
    "aggregateTelemetryDays": 180
  },
  "capabilities": {
    "executor.default": {
      "provider": "codex",
      "model": "gpt-5.6-terra",
      "effort": "xhigh"
    },
    "executor.hard": {
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "effort": "xhigh"
    },
    "semantic.judge": {
      "provider": "claude",
      "model": "claude-opus-5",
      "effort": "high"
    },
    "frontend.primary": {
      "provider": "antigravity",
      "model": "gemini-3.7-flash-high",
      "effort": "high",
      "accountScope": "personal"
    },
    "session.child": {
      "provider": "claude",
      "model": "claude-opus-5",
      "effort": "xhigh"
    },
    "session.child.standard": {
      "provider": "claude",
      "model": "claude-opus-5",
      "effort": "high"
    }
  },
  "risk": {
    "alwaysEscalate": [
      "credential",
      "data-migration",
      "deploy",
      "external-contract",
      "force-push",
      "merge",
      "migration",
      "release"
    ]
  }
}
