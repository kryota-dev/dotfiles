#!/bin/bash
set -euo pipefail

# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}
#
# Failure policy. `brew bundle` exits non-zero when *any* entry fails, and this is a `before`
# script, so propagating that status aborts the entire `chezmoi apply` — before a single dotfile is
# written and before any of the after-scripts run. A retired App Store app or an Intel-only cask
# must not cost the user their shell config, so a partial failure is reported loudly and tolerated.
#
# The exit code alone cannot tell "some entries failed" from "could not run at all": a missing
# Brewfile also exits 1. The fatal conditions are therefore preflighted below, and everything brew
# bundle reports after that point is treated as partial.
BUNDLE_LOG=""
FILTERED_BREWFILE=""

cleanup() {
  [ -n "$BUNDLE_LOG" ] && rm -f "$BUNDLE_LOG"
  [ -n "$FILTERED_BREWFILE" ] && rm -f "$FILTERED_BREWFILE"
  return 0
}
trap cleanup EXIT

# brew bundle reports failures in two shapes: install-phase failures produce one
# "Installing <name> has failed!" line per entry, while fetch-phase failures (an unknown name, say)
# only produce the single summary line. Surface whichever is present so the user always learns what
# was skipped without scrolling back through the whole run.
report_bundle_failure() {
  local log="$1" status="$2"
  {
    echo ""
    echo "################################################################"
    echo "# WARNING: brew bundle did not install everything (exit ${status})."
    echo "# chezmoi apply CONTINUES; your dotfiles are unaffected."
    echo "# Not installed:"
    if grep -q 'has failed!$' "$log"; then
      grep 'has failed!$' "$log" | sed 's/^/#   /'
    elif grep -q '.brew bundle. failed!' "$log"; then
      # brew wraps the command name in backticks here. Matching them with `.` rather than quoting
      # them literally keeps shellcheck from reading a backtick inside single quotes as an attempt
      # at command substitution (SC2016) — do not "fix" this back to a literal backtick.
      grep '.brew bundle. failed!' "$log" | sed 's/^/#   /'
    else
      echo "#   (see the brew bundle output above)"
    fi
    echo "# Fix the cause and re-run 'brew bundle' to retry just these."
    echo "################################################################"
    echo ""
  } >&2
}

{{ if eq .chezmoi.os "linux" -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
echo "Running brew bundle (Linux: filtering incompatible formulas)..."
SOURCE_BREWFILE="{{ .chezmoi.sourceDir }}/dot_Brewfile"
EXCLUDE="{{ .chezmoi.sourceDir }}/../.brewfile-linux-exclude"
FILTERED_BREWFILE=$(mktemp)
grep -E '^(tap |brew )' "$SOURCE_BREWFILE" | grep -v -E -f "$EXCLUDE" >"$FILTERED_BREWFILE"
BREWFILE="$FILTERED_BREWFILE"
{{ else -}}
{{ if eq .chezmoi.arch "arm64" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/usr/local/bin/brew shellenv)"
{{ end -}}
echo "Running brew bundle..."
BREWFILE="{{ .chezmoi.sourceDir }}/dot_Brewfile"
{{ end -}}

# Preflight the two conditions that mean brew bundle never even looked at the Brewfile. These stay
# fatal: silently continuing would skip every single package while reporting success.
if ! command -v brew >/dev/null 2>&1; then
  echo "ERROR: brew is not on PATH; cannot run brew bundle." >&2
  exit 1
fi
if [ ! -r "$BREWFILE" ]; then
  echo "ERROR: Brewfile is not readable: $BREWFILE" >&2
  exit 1
fi

# tee keeps brew's output streaming to the terminal while capturing it for the summary; pipefail
# makes the pipeline carry brew bundle's status rather than tee's. Piping brew's output does not
# break the sudo password prompt that cask installs trigger: sudo(8) reads the password from the
# user's terminal rather than from stdin, and stdin is left attached here either way.
BUNDLE_LOG=$(mktemp)
bundle_status=0
brew bundle --no-upgrade --file="$BREWFILE" 2>&1 | tee "$BUNDLE_LOG" || bundle_status=$?

if [ "$bundle_status" -eq 0 ]; then
  echo "Brew bundle complete."
else
  report_bundle_failure "$BUNDLE_LOG" "$bundle_status"
fi
