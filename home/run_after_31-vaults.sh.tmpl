#!/bin/bash
# Obsidian の vault（エージェントの作業記憶）を、この Mac で使える状態にそろえる。apply のたびに走り、
# 足りないものだけを作る。新しい Mac でも手で覚えておく手順を残さないため。
# 1Password・Google Drive・ツールが使えないときは何もせず、apply を止めない（次の apply でやり直す）。
set -euo pipefail
# バックアップや vault が 1 つも無いとき、glob を文字どおりに残さない。
shopt -s nullglob

# op_vault は chezmoi init で入力する値。CI のように未設定の環境でも描画できるよう get で読む。
op_vault="${OP_VAULT:-{{ get . "op_vault" }}}"
item="Dotfiles - Vault"
key_doc="Dotfiles - Vault GPG key"
vaults="${VAULTS_HOME:-$HOME/vaults}"
cloud="${CLOUD_STORAGE:-$HOME/Library/CloudStorage}"
obsidian_json="${OBSIDIAN_JSON:-$HOME/Library/Application Support/obsidian/obsidian.json}"

skip() {
  echo "vault: $1。次の apply でやり直します。" >&2
  exit 0
}

[ -n "$op_vault" ] || skip "1Password の vault 名（op_vault）が未設定です"
for c in op gpg git git-remote-gcrypt pinentry-mac; do
  command -v "$c" >/dev/null 2>&1 || skip "$c が見つかりません"
done
fpr=$(op read "op://$op_vault/$item/fingerprint" 2>/dev/null) || skip "1Password から「${item}」を読めません"
account=$(op read "op://$op_vault/$item/drive_account" 2>/dev/null) || skip "1Password の「${item}」に drive_account がありません"
# パスフレーズは変数に置かず、使う直前に 1Password から読む。
passphrase() { op read "op://$op_vault/$item/password"; }

# vault 用の GPG 鍵。gcrypt は鍵に暗号化するので、信用度を ultimate にしないと batch の gpg が拒否する。
if ! gpg --list-secret-keys "$fpr" >/dev/null 2>&1; then
  op document get "$key_doc" --vault "$op_vault" |
    gpg --batch --pinentry-mode loopback --passphrase-fd 3 --import 3< <(passphrase) ||
    skip "1Password の「${key_doc}」から GPG 鍵を入れられません"
  echo "$fpr:6:" | gpg --import-ownertrust
  echo "vault: GPG 鍵を 1Password から入れました。"
fi

# pinentry-mac はキーチェーンの service「GnuPG」・account「keygrip」の項目からパスフレーズを読む。
# 署名（主鍵）と復号（副鍵）で keygrip が異なるので、両方を作る。
pinentry=$(command -v pinentry-mac)
for grip in $(gpg --with-keygrip --with-colons --list-secret-keys "$fpr" | awk -F: '/^grp/{print $10}'); do
  security find-generic-password -s GnuPG -a "$grip" >/dev/null 2>&1 && continue
  # security は標準入力からパスワードを読めないので引数で渡す（同じユーザーのプロセス一覧に一瞬だけ現れる）。
  security add-generic-password -s GnuPG -a "$grip" -l GnuPG -T "$pinentry" -w "$(passphrase)"
  echo "vault: pinentry-mac 用のキーチェーン項目を作りました。"
done

# Drive の同期フォルダのバックアップから、手元に無い vault を復元する。マイドライブの名前は OS の言語で変わる。
backups=$(find "$cloud/GoogleDrive-$account" -maxdepth 2 -type d -name vault-backups 2>/dev/null | head -n 1 || true)
[ -n "$backups" ] || skip "Google Drive（${account}）の vault-backups が見つかりません"
mkdir -p "$vaults"
for backup in "$backups"/*/; do
  name=$(basename "$backup")
  dest="$vaults/$name"
  [ -e "$dest" ] && continue
  # gcrypt の push は実質的に常に force になるので、必ず clone から始める。participants を指定しない clone は
  # どの有効な署名も受け入れる。
  git clone -q -c remote.origin.gcrypt-participants="$fpr" "gcrypt::${backup%/}" "$dest" || {
    echo "vault: $name を復元できませんでした。" >&2
    continue
  }
  git -C "$dest" config remote.origin.gcrypt-signingkey "$fpr"
  git -C "$dest" config commit.gpgsign false
  echo "vault: $name を復元しました。"
done

# クライアントの vault の別名（_vault.md の owners）を symlink にする。
for meta in "$vaults"/*/_vault.md; do
  [ -f "$meta" ] || continue
  name=$(basename "$(dirname "$meta")")
  for owner in $(sed -n 's/^owners: *\[\(.*\)\]/\1/p' "$meta" | tr ',' ' '); do
    [ "$owner" = "$name" ] || [ -e "$vaults/$owner" ] && continue
    ln -s "$name" "$vaults/$owner"
  done
done

# Obsidian の vault の一覧に登録する。Obsidian は起動中に一覧を書き戻すので、起動していないときだけ触る。
pgrep -x Obsidian >/dev/null 2>&1 && exit 0
mkdir -p "$(dirname "$obsidian_json")"
[ -s "$obsidian_json" ] || printf '%s\n' '{"vaults":{}}' >"$obsidian_json"
for dir in "$vaults"/*/; do
  [ -L "${dir%/}" ] && continue
  path="${dir%/}"
  # plutil は / を \/ にエスケープして書くので、両方の形で照合する。
  grep -qF -e "\"$path\"" -e "\"${path//\//\\/}\"" "$obsidian_json" && continue
  plutil -insert "vaults.$(openssl rand -hex 8)" -json "{\"path\":\"$path\",\"ts\":$(date +%s)000}" "$obsidian_json"
  echo "vault: $(basename "$path") を Obsidian に登録しました。"
done
