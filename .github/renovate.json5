{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests', ':pinAllExceptPeerDependencies'],
  // schedule は付けない。Mend の hosted app は実行の時刻を選べず、Renovate の PR がマージされていない
  // リポジトリは 1 日 1 回しか実行しないので、時間の窓を絞ると更新の PR が出なくなる。
  rebaseWhen: 'conflicted',
  // mise の config.toml は GitHub の Dependabot alerts の対象外なので、OSV で脆弱性を拾う。OSV が扱うのは
  // npm・PyPI などの datasource だけで、mise の npm: の backend には効くが、ランタイムや GitHub Releases から
  // 入れる CLI には効かない。脆弱性の PR は Renovate の既定で minimumReleaseAge を外され、3 日待たない。
  osvVulnerabilityAlerts: true,
  // 既定の 'none' では Dependency Dashboard に OSV の結果が出ず、照会が動いたかを確かめられない。
  // 'all' なら、0 件のときも「CVE が見つからなかった」と出る。
  dependencyDashboardOSVVulnerabilitySummary: 'all',
  mise: {
    managerFilePatterns: ['/^home/dot_config/mise/config\\.toml$/'],
  },
  customManagers: [
    {
      // .chezmoidata.toml の `# renovate:` コメント付きの pin を追跡する。
      customType: 'regex',
      managerFilePatterns: ['/^home/\\.chezmoidata\\.toml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) branch=(?<currentValue>\\S+)\\n\\w+ = "(?<currentDigest>[a-f0-9]{40})"',
        '# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>\\S+) version=(?<currentValue>\\S+)\\n\\w+ = "(?<currentDigest>[a-f0-9]{40})"',
        '# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>\\S+)\\n\\w+ = "(?<currentValue>[^"]+)"',
      ],
    },
  ],
  packageRules: [
    {
      // 通常のバージョン更新は 1 つの PR にまとめ、CI が通れば自動でマージする。リリースの直後は
      // mise のレジストリが追いついておらず、取り下げられる悪意のあるリリースもあるので、3 日待つ。
      matchUpdateTypes: ['minor', 'patch', 'pin', 'pinDigest'],
      groupName: 'non-major dependencies',
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      // Moralerspace のリリースタグには先頭に "v" が付く。
      matchDepNames: ['yuru7/moralerspace'],
      extractVersion: '^v(?<version>.+)$',
    },
    {
      // skill の本文はエージェントの挙動を左右し、ax は 1.0 前で skill が CLI のリリースに
      // 紐づくため、自動マージせず手で確認する。
      matchDepNames: ['anthropics/skills', 'anthropics/claude-plugins-community', 'coji/natural-japanese', 'kepano/obsidian-skills', 'yusukebe/ax', 'github:yusukebe/ax'],
      groupName: null,
      automerge: false,
    },
    {
      matchDepNames: ['yusukebe/ax', 'github:yusukebe/ax'],
      groupName: 'ax',
    },
    {
      // skill は CLI から本文を読み込む入口だけなので、CLI と一緒に自動マージする。
      matchDepNames: ['vercel-labs/agent-browser', 'npm:agent-browser'],
      groupName: 'agent-browser',
    },
    {
      // workflow はトークンを持って動くので、Actions の更新は手で確認する。
      matchManagers: ['github-actions'],
      automerge: false,
      groupName: 'github actions',
    },
  ],
}
