{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':pinAllExceptPeerDependencies',
    'mergeConfidence:all-badges',
    ':disableRateLimiting',
    ':prConcurrentLimit10',
    'group:definitelyTyped',
    'helpers:pinGitHubActionDigests',
  ],
  rebaseWhen: 'conflicted',
  automergeType: 'pr',
  // Every update type is an automerge candidate. Whether a given PR actually
  // merges is decided by the `renovate-gate` required status check
  // (.github/workflows/renovate-gate.yml), never by this file.
  //
  // The per-updateType lanes that used to live here (minor off, patch/pin on)
  // plus four packageRules pinning automerge off for the risky dependencies were
  // a second, weaker copy of that judgement. Weaker because the only signal
  // available in config is updateType, and updateType is precisely the signal
  // that fails for the dependencies that most need judgement: a digest bump of a
  // skill archive is a one-line diff tracking a moving `main` with no upstream
  // release step, and config cannot tell that apart from a tagged patch release.
  // The gate reads the actual update instead.
  automerge: true,
  // Keep waiting for the branch to go green. The gate is one of the required
  // checks, so this is what makes Renovate hold until the whole set passes.
  ignoreTests: false,
  // Every managerFilePatterns entry below (and the mise one at the bottom of this
  // file) is a slash-delimited string, which Renovate parses as a regex, not a
  // glob. It matches against fileList entries from `git ls-tree -r`, i.e.
  // repo-root-relative paths with no leading `/` or `./` -- so `^` anchors to the
  // repo root and every pattern here is written as a full `^...$` match. Without
  // that anchor the compiled regex (RE2 by default) matches anywhere in the path
  // rather than the whole of it, so a pattern like
  // `/home/dot_config/mise/config\.toml/` also matches nested copies such as
  // tests/fixtures/.../repo/home/dot_config/mise/config.toml -- the fixture #641
  // added and then renamed away once we saw Renovate could read it as a real
  // dependency (#646).
  //
  // The anchors make that intent readable from the pattern itself; they are not
  // the only thing keeping such a fixture out, and they are not a boundary.
  // `config:recommended` pulls in `:ignoreModulesAndTests`, whose ignorePaths
  // (`**/tests/**` among them) drop those files before any manager sees them.
  // And user patterns are *added* to a manager's defaults rather than replacing
  // them, so the mise manager's own `**/{,.}mise/config{,.*}.toml` default keeps
  // matching nested copies no matter what the entry below says.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        'anthropic_commit\\s*=\\s*"(?<currentDigest>[a-f0-9]+)"',
      ],
      depNameTemplate: 'anthropics/skills',
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/anthropics/skills',
      currentValueTemplate: 'main',
    },
    {
      // Official drawio skill from jgraph/drawio-mcp (external in .chezmoiexternal.toml).
      // Same tracking pattern as anthropic_commit above.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        'drawio_mcp_commit\\s*=\\s*"(?<currentDigest>[a-f0-9]+)"',
      ],
      depNameTemplate: 'jgraph/drawio-mcp',
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/jgraph/drawio-mcp',
      currentValueTemplate: 'main',
    },
    {
      // Official Supabase agent skills — one pin covers both external entries
      // (supabase and supabase-postgres-best-practices).
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        'supabase_agent_skills_commit\\s*=\\s*"(?<currentDigest>[a-f0-9]+)"',
      ],
      depNameTemplate: 'supabase/agent-skills',
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/supabase/agent-skills',
      currentValueTemplate: 'main',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        'moralerspace_font\\s*=\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: 'yuru7/moralerspace',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      // ECC ships executable hook code, so it is pinned to an immutable commit digest (not a
      // moveable tag). github-tags tracks release tags and updates both the version and the
      // commit digest in [ecc]. ECC ships third-party hook code that runs in every session,
      // so it never reaches the deterministic fast lane: renovate-gate classifies a digest
      // bump as needing agent review regardless of how small the diff is.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        '\\[ecc\\][\\s\\S]*?version\\s*=\\s*"(?<currentValue>[^"]+)"[\\s\\S]*?commit\\s*=\\s*"(?<currentDigest>[a-f0-9]+)"',
      ],
      depNameTemplate: 'affaan-m/ECC',
      packageNameTemplate: 'affaan-m/ECC',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      // Self-hosted ntfy server image (#337). The tag is pinned literally in the
      // compose template (chezmoi .tmpl files are invisible to the built-in
      // docker-compose manager), so track it with a regex manager instead.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/ntfy/compose\\.yaml\\.tmpl$/',
      ],
      matchStrings: [
        'image: binwiederhier/ntfy:(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      depNameTemplate: 'binwiederhier/ntfy',
      datasourceTemplate: 'docker',
    },
    {
      // Brief-page static-file sidecar image (#361), pinned literally in the
      // same compose template — tracked with a regex manager like ntfy above.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/dot_config/ntfy/compose\\.yaml\\.tmpl$/',
      ],
      matchStrings: [
        'image: nginx:(?<currentValue>[0-9.]+-alpine)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      depNameTemplate: 'nginx',
      datasourceTemplate: 'docker',
    },
    {
      // phone-harness CLI (ShawnPana/phone-harness), installed by
      // run_onchange_after_19-setup-phone-harness.sh.tmpl via `uv tool install`.
      // The pin is a PyPI release rather than a git ref, so it needs its own
      // manager separate from the SKILL.md digest below. Scoped to the
      // [phone_harness] table so it cannot latch onto a `version =` elsewhere.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        '\\[phone_harness\\][\\s\\S]*?version\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'phone-harness',
      datasourceTemplate: 'pypi',
    },
    {
      // phone-harness SKILL.md, fetched as a file external in
      // .chezmoiexternal.toml. Tracked as a commit digest like the other
      // third-party skills (drawio, supabase) instead of as the PyPI release
      // above: the two artifacts move independently upstream.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        '\\[phone_harness\\][\\s\\S]*?commit\\s*=\\s*"(?<currentDigest>[a-f0-9]+)"',
      ],
      depNameTemplate: 'ShawnPana/phone-harness',
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/ShawnPana/phone-harness',
      currentValueTemplate: 'main',
    },
    {
      // eli5 skill, fetched as a file external in .chezmoiexternal.toml. Tracked as a
      // commit digest like the other third-party skills (drawio, supabase,
      // phone-harness SKILL.md) — this repo has no PyPI/npm release to pin instead.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        '\\[eli5\\][\\s\\S]*?commit\\s*=\\s*"(?<currentDigest>[a-f0-9]+)"',
      ],
      depNameTemplate: 'anthropics/claude-plugins-community',
      datasourceTemplate: 'git-refs',
      packageNameTemplate: 'https://github.com/anthropics/claude-plugins-community',
      currentValueTemplate: 'main',
    },
    {
      // ax skill (skills/ax/SKILL.md), fetched as a file external from [ax].commit.
      // github-tags rather than the git-refs form used by the skills above: ax has real
      // release tags, and the SKILL.md pin must land on the same release as the CLI pin
      // in the mise config, not on whatever `main` happens to be. Shaped like the [ecc]
      // manager — one regex capturing version and commit together, so a bump moves both
      // in a single hunk. Scoped to the [ax] table so it cannot latch onto a `version =`
      // or `commit =` in a neighbouring one.
      customType: 'regex',
      managerFilePatterns: [
        '/^home/\\.chezmoidata\\.toml$/',
      ],
      matchStrings: [
        '\\[ax\\][\\s\\S]*?version\\s*=\\s*"(?<currentValue>[^"]+)"[\\s\\S]*?commit\\s*=\\s*"(?<currentDigest>[a-f0-9]+)"',
      ],
      depNameTemplate: 'yusukebe/ax',
      packageNameTemplate: 'yusukebe/ax',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
  ],
  packageRules: [
    {
      // NOT an automerge lane. The four automerge packageRules this file used to carry
      // were deleted when the merge gate landed (see the automerge comment at the top),
      // and nothing here revives them — this rule only decides how updates are BATCHED.
      //
      // ax ships two artifacts from one upstream release, pinned in two files: the CLI
      // in home/dot_config/mise/config.toml (read by the built-in mise manager) and
      // skills/ax/SKILL.md via [ax] in home/.chezmoidata.toml (read by the custom manager
      // above). tests/ax.bats asserts the two versions agree, so a bump that arrived as
      // two PRs would make BOTH of them red — each one half-applies the update — and
      // neither could merge alone. Grouping them onto one branch is what keeps that
      // assertion satisfiable. tests/ax.bats also asserts this rule still exists, because
      // deleting it would not break anything until the next ax release.
      matchPackageNames: [
        'yusukebe/ax',
      ],
      groupName: 'ax',
    },
  ],
  mise: {
    // Anchored full-match regex; see the customManagers comment above for why.
    managerFilePatterns: [
      '/^home/dot_config/mise/config\\.toml$/',
    ],
  },
}
